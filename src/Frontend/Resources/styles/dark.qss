/* Global dark theme */

* {
  font-family: 'Segoe UI', 'Inter', 'Roboto', sans-serif;
  font-size: 12px;
}

QWidget {
  background-color: #2b2b2b;
  color: #ffffff;
}

QMainWindow, QDialog, QFrame, QGroupBox {
  background-color: #2b2b2b;
}

QMenuBar, QStatusBar {
  background-color: #2b2b2b;
  color: #ffffff;
}

QMenu {
  background-color: #3c3c3c;
  color: #ffffff;
  border: 1px solid #555;
}
QMenu::item:selected {
  background-color: #555;
}

/* Panels */
#leftSidebar { background-color: #3c3c3c; border-right: 1px solid #555; }
#rightPanel { background-color: #3c3c3c; border-left: 1px solid #555; }
#searchBar { background-color: #3c3c3c; border-bottom: 1px solid #555; }

/* Inputs */
QLineEdit, QSpinBox, QComboBox, QDateEdit, QTextEdit {
  background-color: #555;
  border: 1px solid #777;
  border-radius: 4px;
  padding: 5px 8px;
  color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QDateEdit:focus, QTextEdit:focus {
  border-color: #0078d4;
}

/* Buttons */
QPushButton {
  background-color: #0078d4;
  border: none;
  border-radius: 5px;
  color: #ffffff;
  padding: 6px 12px;
}
QPushButton:hover { background-color: #106ebe; }
QPushButton:pressed { background-color: #005a9e; }

/* Tool buttons (used in TopBarWidget) */
QToolButton {
  background-color: #3a3a3a;
  border: 1px solid #666;
  border-radius: 6px;
  color: #ffffff;
  padding: 6px 10px;
}
QToolButton:hover { background-color: #4a4a4a; border-color: #777; }
QToolButton:pressed { background-color: #2f2f2f; border-color: #0078d4; }
/* Make top-bar tool buttons slightly tighter */
#searchBar QToolButton { padding: 6px 10px; }

/* CheckBox */
QCheckBox { color: #ffffff; }
QCheckBox::indicator { width: 16px; height: 16px; }
QCheckBox::indicator:unchecked { background-color: #555; border: 1px solid #777; border-radius: 3px; }
QCheckBox::indicator:checked { background-color: #0078d4; border: 1px solid #0078d4; border-radius: 3px; }

/* Scrolls */
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background-color: #555; width: 12px; border-radius: 6px; }
QScrollBar::handle:vertical { background-color: #777; border-radius: 6px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background-color: #888; }

/* Labels */
#titleLabel { font-size: 18px; font-weight: 600; }
#authorLabel, #yearLabel, #durationLabel, #summaryLabel, #coverPathLabel { color: #e0e0e0; }

/* Danger button */
#deleteBtn { background-color: #d13438; }
#deleteBtn:hover { background-color: #b02a2e; }

/* Media cards */
#mediaCard {
  background-color: #3c3c3c;
  border: 1px solid #555;
  border-radius: 8px;
  padding: 10px;
}
#mediaCard:hover { border: 1px solid #0078d4; background-color: #444; }
#mediaCard #coverBox { border: 1px solid #555; border-radius: 8px; background-color: #444; }
#mediaCard #typeBadge { color: #ffffff; font-size: 10px; padding: 2px 6px; background-color: #555; border-radius: 8px; }
#mediaCard #mediaTitle { color: #ffffff; font-size: 14px; font-weight: bold; }
#mediaCard #mediaYear { color: #cccccc; font-size: 12px; }

/* Details panel cover image */
#rightPanel #coverImage { border: none; background: transparent; }

/* Lists (LeftSidebar categories) */
QListWidget {
  background-color: #3c3c3c;
  border: 1px solid #555;
  border-radius: 6px;
}
QListWidget::item { padding: 8px 10px; }
QListWidget::item:selected { background-color: #555; color: #ffffff; }
QListWidget::item:hover { background-color: #4a4a4a; }

/* Combobox (sort, etc.) */
QComboBox {
  background-color: #555;
  border: 1px solid #777;
  border-radius: 4px;
  padding: 4px 8px;
  color: #ffffff;
}
QComboBox:hover { border-color: #888; }
QComboBox QAbstractItemView { background-color: #3c3c3c; color: #ffffff; border: 1px solid #555; }

/* Group boxes (Details attributes) */
QGroupBox {
  border: 1px solid #555;
  border-radius: 6px;
  margin-top: 10px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 5px;
  color: #e0e0e0;
}
